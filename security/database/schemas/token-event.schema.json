{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.ai/schemas/token/token-event.schema.json",
  "title": "JARVIS Token Domain Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "aggregateId",
    "occurredAt",
    "version",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "const": "jarvis"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
