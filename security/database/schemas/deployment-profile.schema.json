{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.ai/schemas/token/deployment-profile.schema.json",
  "title": "JARVIS token deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "asset",
    "canonicalChain",
    "sourceProfile",
    "sui",
    "solana",
    "bridge",
    "releaseGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "environment": {
      "enum": [
        "testnet",
        "mainnet"
      ]
    },
    "asset": {
      "const": "jarvis"
    },
    "canonicalChain": {
      "const": "sui"
    },
    "sourceProfile": {
      "enum": [
        "token/contracts/sui-testnet",
        "token/contracts/sui-mainnet"
      ]
    },
    "sui": {
      "type": "object",
      "required": [
        "packageId",
        "coinType",
        "metadataObjectId",
        "fixedSupplyObjectId",
        "genesisReceiptObjectId",
        "publishedTransactionDigest",
        "verified"
      ]
    },
    "solana": {
      "type": "object",
      "required": [
        "representation",
        "provider",
        "standard",
        "mint",
        "nttManagerProgramId",
        "bridgeProgramId",
        "mintAuthority",
        "freezeAuthority",
        "genesisSupplyBaseUnits",
        "suiChainId",
        "maxTransferBaseUnits",
        "verified"
      ],
      "properties": {
        "suiChainId": {
          "const": 21
        },
        "maxTransferBaseUnits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "bridge": {
      "type": "object",
      "required": [
        "enabled",
        "provider",
        "protocol",
        "exactOneToOne",
        "chainDomains",
        "maxTransferBaseUnits"
      ],
      "properties": {
        "chainDomains": {
          "type": "object",
          "required": [
            "solana",
            "sui"
          ],
          "properties": {
            "solana": {
              "const": 1
            },
            "sui": {
              "const": 21
            }
          },
          "additionalProperties": false
        },
        "maxTransferBaseUnits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "releaseGate": {
      "type": "object",
      "required": [
        "canonicalTokenVerified",
        "bridgeRepresentationVerified",
        "reserveMonitorEnabled",
        "emergencyPauseConfigured"
      ]
    }
  }
}
