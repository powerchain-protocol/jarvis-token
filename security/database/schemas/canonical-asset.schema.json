{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.ai/schemas/token/canonical-asset.schema.json",
  "title": "JARVIS Canonical Asset Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonicalId", "symbol", "canonicalChain", "representations", "recordedAt"],
  "properties": {
    "canonicalId": { "const": "jarvis" },
    "symbol": { "const": "JARVIS" },
    "canonicalChain": { "const": "sui" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "representations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "type", "standard"],
        "properties": {
          "chain": { "enum": ["sui", "solana"] },
          "type": { "enum": ["canonical", "bridged"] },
          "standard": { "enum": ["Sui Coin", "Token-2022"] },
          "provider": { "const": "wormhole" },
          "address": { "type": ["string", "null"] }
        }
      }
    }
  }
}
