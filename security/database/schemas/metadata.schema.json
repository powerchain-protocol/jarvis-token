{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.ai/schemas/token/metadata.schema.json",
  "title": "JARVIS Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "symbol", "description", "image", "version", "decimals", "supply", "attributes", "properties", "deployment"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "const": "JARVIS" },
    "symbol": { "const": "JARVIS" },
    "description": { "type": "string", "minLength": 20 },
    "image": { "type": "string" },
    "version": { "type": "string" },
    "decimals": { "const": 6 },
    "supply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "wholeTokens", "baseUnits"],
      "properties": {
        "model": { "const": "fixed" },
        "wholeTokens": { "const": "18440000000" },
        "baseUnits": { "const": "18440000000000000" }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "properties": {
      "type": "object",
      "required": ["category", "canonicalChain", "bridgeModel", "canonicalImage", "files", "solanaRepresentationType", "bridgeProvider", "displayPolicy"],
      "properties": {
        "category": { "const": "utility-token" },
        "canonicalChain": { "const": "sui" },
        "bridgeModel": { "const": "lock-mint-burn-release" },
        "canonicalImage": { "enum": ["green", "dark", "light"] },
        "solanaRepresentationType": { "const": "bridged" },
        "bridgeProvider": { "const": "wormhole" },
        "displayPolicy": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "type", "theme", "width", "height", "sha256"],
            "properties": {
              "uri": { "type": "string" },
              "type": { "const": "image/png" },
              "theme": { "enum": ["canonical", "dark", "light"] },
              "width": { "type": "integer", "minimum": 512 },
              "height": { "type": "integer", "minimum": 512 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solanaMint", "suiCoinType", "wormholeProviderId", "verified"],
      "properties": {
        "solanaMint": { "type": ["string", "null"] },
        "suiCoinType": { "type": ["string", "null"] },
        "wormholeProviderId": { "type": ["string", "null"] },
        "verified": { "type": "boolean" }
      }
    }
  }
}
