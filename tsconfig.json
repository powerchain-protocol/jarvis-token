{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../target/token-types",
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "common/**/*.ts",
    "constants/**/*.ts",
    "context/**/*.ts",
    "functions/**/*.ts",
    "security/**/*.ts",
    "storage/**/*.ts",
    "ui/**/*.ts",
    "utils/**/*.ts",
    "validation/**/*.ts",
    "services/**/*.ts"
  ]
}
