{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "common/**/*.ts",
    "constants/**/*.ts",
    "context/**/*.ts",
    "functions/**/*.ts",
    "security/*.ts",
    "storage/**/*.ts",
    "ui/**/*.ts",
    "utils/**/*.ts",
    "validation/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target",
    "dist"
  ]
}
