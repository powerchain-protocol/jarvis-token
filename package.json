{
  "name": "@powerchain/jarvis-token",
  "version": "1.0.0-rc.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && npm run check:scripts",
    "check:scripts": "bash -n scripts/*.sh",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "prejarvis": "npm run build",
    "jarvis": "node dist/packages/token-core/src/cli.js",
    "jarvis:dev": "tsx packages/token-core/src/cli.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.4",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
