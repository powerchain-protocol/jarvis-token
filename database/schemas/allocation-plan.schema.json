{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.ai/schemas/token/allocation-plan.schema.json",
  "title": "JARVIS Allocation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "governanceRecord",
    "reviewers",
    "allocations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "governanceRecord": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allocationId",
          "category",
          "beneficiaryClass",
          "custodyAddress",
          "percentageBps",
          "amountBaseUnits"
        ],
        "properties": {
          "allocationId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "ecosystem",
              "team",
              "development",
              "treasury",
              "liquidity",
              "marketing",
              "reserve",
              "incentives",
              "other"
            ]
          },
          "beneficiaryClass": {
            "type": "string",
            "minLength": 1
          },
          "custodyAddress": {
            "type": "string",
            "minLength": 1
          },
          "percentageBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "amountBaseUnits": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "roundingAdjustmentBaseUnits": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "beneficiaryAddress": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
